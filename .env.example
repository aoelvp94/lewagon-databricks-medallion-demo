# Copy to .env and fill with your Databricks workspace values.
# Never commit real tokens. .env is gitignored.

# Workspace URL (with or without https://)
# Example personal Free Edition host (placeholder — replace with yours):
# DATABRICKS_HOST=https://dbc-xxxx.cloud.databricks.com
DATABRICKS_HOST=https://dbc-<workspace>.cloud.databricks.com

# SQL Warehouse HTTP path (Compute → SQL warehouses → Connection details)
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse_id>

# Personal access token (Settings → Developer → Access tokens)
DATABRICKS_TOKEN=dapi...

# Unity Catalog name where raw/bronze/silver/gold schemas live
DATABRICKS_CATALOG=workspace

# Default dbt schema (Cosmos profile_args also pin bronze)
DATABRICKS_SCHEMA=bronze

# Invented LW Commerce API (docker-compose service name "api" on Astro network)
API_BASE_URL=http://api:8000
API_KEY=lewagon-demo

# Airflow UI pinned away from 8080 (see docker-compose.override.yml)
AIRFLOW__CORE__LAZY_LOAD_PLUGINS=False
